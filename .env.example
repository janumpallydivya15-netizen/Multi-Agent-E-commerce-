# ==============================================================================
# Multi-Agent E-Commerce Assistant Environment Configuration
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Global LLM Execution Mode (MOCK or GEMINI)
# Set to 'MOCK' for offline testing / zero-cost development.
# Set to 'GEMINI' to activate live Google Gemini models.
LLM_MODE=MOCK

# Model Selection for Gemini API
MODEL_NAME=gemini-2.5-flash

# Google Gemini API Key (Required when LLM_MODE=GEMINI)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port and Host for Production / Docker
SERVER_PORT=8501
SERVER_HOST=0.0.0.0

# Optional Agent-specific Mock Mode Overrides (true/false)
# When set, these override the global LLM_MODE for individual agents:
REQUIREMENT_AGENT_MOCK_MODE=true
PRODUCT_SEARCH_AGENT_MOCK_MODE=true
REVIEW_AGENT_MOCK_MODE=true
PRICE_SPECS_AGENT_MOCK_MODE=true
RECOMMENDATION_AGENT_MOCK_MODE=true
